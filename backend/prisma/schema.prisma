generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String?        @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(RECEPTIONIST)
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  staffProfile  StaffProfile?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model StaffProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique @map("user_id")
  fullName           String               @map("full_name")
  specialization     String?
  licenseNo          String?              @map("license_no")
  departmentId       String?              @map("department_id")
  phone              String?
  isAvailable        Boolean              @default(true) @map("is_available")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Patient {
  id                String            @id @default(uuid())
  mrn               String            @unique @map("mrn")
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  dob               DateTime          @map("dob")
  gender            String
  phone             String
  email             String?
  nationalId        String            @unique @map("national_id")
  address           String?
  bloodGroup        String?           @map("blood_group")
  emergencyContact  String?           @map("emergency_contact")
  isArchived        Boolean           @default(false) @map("is_archived")
  archivedAt        DateTime?         @map("archived_at")
  lastActivityAt    DateTime          @default(now()) @map("last_activity_at")
  totalExpectedFees Decimal           @default(0) @map("total_expected_fees") @db.Decimal(12, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  emergencyAccess   EmergencyAccess[]
  encounters        Encounter[]
  invoices          Invoice[]
  allergies         PatientAllergy[]

  @@index([phone])
  @@index([mrn])
  @@index([isArchived])
  @@index([lastActivityAt])
  @@map("patients")
}

model PatientAllergy {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  substance String
  severity  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_allergies")
}

model Encounter {
  id                      String             @id @default(uuid())
  patientId               String             @map("patient_id")
  nurseId                 String?            @map("nurse_id")
  doctorId                String?            @map("doctor_id")
  chiefComplaint          String?            @map("chief_complaint")
  subjective              String?
  objective               String?
  assessment              String?
  plan                    String?
  icd10Code               String?            @map("icd10_code")
  labResultInterpretation String?            @map("lab_result_interpretation")
  visitStatus             VisitStatus        @default(TRIAGE) @map("visit_status")
  signedAt                DateTime?          @map("signed_at")
  signedBy                String?            @map("signed_by")
  dischargeNotes          String?            @map("discharge_notes")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  doctorAssignments       DoctorAssignment[]
  encounterFees           EncounterFee[]
  patient                 Patient            @relation(fields: [patientId], references: [id])
  invoices                Invoice[]
  labOrders               LabOrder[]
  nurseAssignments        NurseAssignment[]
  prescription            Prescription?
  vitals                  Vital[]

  @@index([patientId])
  @@index([visitStatus])
  @@index([nurseId])
  @@index([doctorId])
  @@map("encounters")
}

model Vital {
  id           String    @id @default(uuid())
  encounterId  String    @map("encounter_id")
  temperatureC Float?    @map("temperature_c")
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  respRate     Int?      @map("resp_rate")
  spo2         Int?
  weightKg     Float?    @map("weight_kg")
  heightCm     Float?    @map("height_cm")
  bmi          Float?
  recordedBy   String    @map("recorded_by")
  recordedAt   DateTime  @default(now()) @map("recorded_at")
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vitals")
}

model NurseAssignment {
  id              String    @id @default(uuid())
  encounterId     String    @map("encounter_id")
  nurseId         String    @map("nurse_id")
  assignedBy      String    @map("assigned_by")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")
  completedAt     DateTime? @map("completed_at")
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([nurseId, status])
  @@index([encounterId])
  @@map("nurse_assignments")
}

model DoctorAssignment {
  id              String    @id @default(uuid())
  encounterId     String    @map("encounter_id")
  doctorId        String    @map("doctor_id")
  assignedBy      String    @map("assigned_by")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")
  completedAt     DateTime? @map("completed_at")
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@index([encounterId])
  @@map("doctor_assignments")
}

model LabTest {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  department     String
  price          Decimal     @db.Decimal(10, 2)
  referenceRange String?     @map("reference_range")
  unit           String?
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  labResults     LabResult[]

  @@map("lab_tests")
}

model LabOrder {
  id             String          @id @default(uuid())
  encounterId    String          @map("encounter_id")
  patientId      String          @map("patient_id")
  orderedBy      String          @map("ordered_by")
  status         LabStatus       @default(ORDERED)
  orderedAt      DateTime        @default(now()) @map("ordered_at")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  labAssignments LabAssignment[]
  encounter      Encounter       @relation(fields: [encounterId], references: [id])
  results        LabResult[]

  @@map("lab_orders")
}

model LabResult {
  id             String   @id @default(uuid())
  labOrderId     String   @map("lab_order_id")
  labTestId      String   @map("lab_test_id")
  value          String
  unit           String?
  referenceRange String?  @map("reference_range")
  flag           String?
  enteredBy      String   @map("entered_by")
  enteredAt      DateTime @default(now()) @map("entered_at")
  labOrder       LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest        LabTest  @relation(fields: [labTestId], references: [id])

  @@map("lab_results")
}

model LabAssignment {
  id              String    @id @default(uuid())
  labOrderId      String    @map("lab_order_id")
  labTechId       String    @map("lab_tech_id")
  assignedBy      String    @map("assigned_by")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")
  completedAt     DateTime? @map("completed_at")
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  labOrder        LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labTechId, status])
  @@index([labOrderId])
  @@map("lab_assignments")
}

model Service {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  category  String?
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNo      String        @unique @map("invoice_no")
  patientId      String        @map("patient_id")
  encounterId    String?       @map("encounter_id")
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal?      @map("discount_amount") @db.Decimal(12, 2)
  discountReason String?       @map("discount_reason")
  taxAmount      Decimal?      @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  balance        Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime?     @map("issued_at")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  items          InvoiceItem[]
  encounter      Encounter?    @relation(fields: [encounterId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  payments       Payment[]

  @@index([patientId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  itemType    String   @map("item_type")
  refId       String?  @map("ref_id")
  description String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id         String        @id @default(uuid())
  invoiceId  String        @map("invoice_id")
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  receivedBy String        @map("received_by")
  receivedAt DateTime      @default(now()) @map("received_at")
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model FeeConfiguration {
  id          String   @id @default(uuid())
  feeType     FeeType  @unique @map("fee_type")
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("fee_configurations")
}

model EncounterFee {
  id          String    @id @default(uuid())
  encounterId String    @map("encounter_id")
  feeType     FeeType   @map("fee_type")
  description String
  amount      Decimal   @db.Decimal(12, 2)
  loggedAt    DateTime  @default(now()) @map("logged_at")
  loggedBy    String    @map("logged_by")
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([feeType])
  @@index([isPaid])
  @@map("encounter_fees")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  actorRole   String   @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  fieldName   String?  @map("field_name")
  before      String?
  after       String?
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmergencyAccess {
  id           String    @id @default(uuid())
  patientId    String    @map("patient_id")
  userId       String    @map("user_id")
  reason       String
  authorizedBy String?   @map("authorized_by")
  authorizedAt DateTime? @map("authorized_at")
  expiresAt    DateTime? @map("expires_at")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    String?   @map("revoked_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("emergency_access")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  patientId String?   @map("patient_id")
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([patientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Prescription {
  id           String    @id @default(uuid())
  encounterId  String    @unique @map("encounter_id")
  doctorId     String    @map("doctor_id")
  medications  String
  instructions String?
  printedAt    DateTime? @map("printed_at")
  printedBy    String?   @map("printed_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("prescriptions")
}

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
}

enum LabStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  TRIAGE
  NURSE_EXAMINATION
  WAITING_FOR_DOCTOR
  DOCTOR_CONSULT
  LAB_PENDING
  LAB_RESULTS_READY
  DOCTOR_REVIEW
  BILLING
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FeeType {
  REGISTRATION
  TRIAGE
  NURSE_EXAMINATION
  DOCTOR_CONSULTATION
  LAB_TEST
  PRESCRIPTION
  PROCEDURE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
  MOBILE_MONEY
  BANK_TRANSFER
}
