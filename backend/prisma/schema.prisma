// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enumerations
enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LabStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  TRIAGE
  NURSE_EXAMINATION
  WAITING_FOR_DOCTOR
  DOCTOR_CONSULT
  LAB_PENDING
  LAB_READY
  BILLING
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FeeType {
  REGISTRATION
  TRIAGE
  NURSE_EXAMINATION
  DOCTOR_CONSULTATION
  LAB_TEST
  PROCEDURE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
  MOBILE_MONEY
  BANK_TRANSFER
}

// Models
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(RECEPTIONIST)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staffProfile StaffProfile?

  @@map("users")
}

model StaffProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  fullName       String   @map("full_name")
  specialization String?
  licenseNo      String?  @map("license_no")
  departmentId   String?  @map("department_id")
  phone          String?
  isAvailable    Boolean  @default(true) @map("is_available")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorAvailability DoctorAvailability[]
  nurseAvailability  NurseAvailability[]

  @@map("staff_profiles")
}

model DoctorAvailability {
  id          String   @id @default(uuid())
  doctorId    String   @map("doctor_id")
  weekday     Int      // 0-6 (Sunday-Saturday)
  startTime   String   @map("start_time")   // HH:MM format
  endTime     String   @map("end_time")     // HH:MM format
  slotMinutes Int      @map("slot_minutes")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctor StaffProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_availability")
}

model NurseAvailability {
  id          String   @id @default(uuid())
  nurseId     String   @map("nurse_id")
  weekday     Int      // 0-6 (Sunday-Saturday)
  startTime   String   @map("start_time")   // HH:MM format
  endTime     String   @map("end_time")     // HH:MM format
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  nurse StaffProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@map("nurse_availability")
}

model Patient {
  id               String   @id @default(uuid())
  mrn              String   @unique @map("mrn") // Medical Record Number
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  dob              DateTime @map("dob") // Date of Birth
  gender           String
  phone            String
  email            String?
  nationalId       String   @unique @map("national_id")
  address          String?
  bloodGroup       String?  @map("blood_group")
  emergencyContact String?  @map("emergency_contact")
  isArchived       Boolean  @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  appointments     Appointment[]
  encounters       Encounter[]
  invoices         Invoice[]
  allergies        PatientAllergy[]
  emergencyAccess  EmergencyAccess[]

  @@map("patients")
  @@index([phone])
  @@index([mrn])
  @@index([isArchived])
  @@index([lastActivityAt])
}

model PatientAllergy {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  substance String
  severity  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_allergies")
}

model Appointment {
  id             String           @id @default(uuid())
  patientId      String           @map("patient_id")
  doctorId       String           @map("doctor_id")
  scheduledAt    DateTime         @map("scheduled_at")
  durationMin    Int              @map("duration_min")
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  createdBy      String?          @map("created_by")
  cancelledReason String?         @map("cancelled_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  patient    Patient    @relation(fields: [patientId], references: [id])
  encounter  Encounter?

  @@unique([doctorId, scheduledAt], name: "unique_doctor_slot")
  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@map("appointments")
}

model Encounter {
  id            String      @id @default(uuid())
  appointmentId String?     @unique @map("appointment_id")
  patientId     String      @map("patient_id")
  nurseId       String?     @map("nurse_id")
  doctorId      String?     @map("doctor_id")
  chiefComplaint String?     @map("chief_complaint")
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  icd10Code     String?     @map("icd10_code")
  labResultInterpretation String? @map("lab_result_interpretation")
  visitStatus   VisitStatus @default(TRIAGE) @map("visit_status")
  signedAt      DateTime?   @map("signed_at")
  signedBy      String?     @map("signed_by")
  dischargeNotes String?   @map("discharge_notes")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  patient       Patient             @relation(fields: [patientId], references: [id])
  vitals        Vital[]
  labOrders     LabOrder[]
  attachments   Attachment[]
  invoices      Invoice[]
  nurseAssignments NurseAssignment[]
  doctorAssignments DoctorAssignment[]
  encounterFees EncounterFee[]

  @@map("encounters")
  @@index([patientId])
  @@index([visitStatus])
  @@index([nurseId])
  @@index([doctorId])
}

model Vital {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  temperatureC Float?  @map("temperature_c")
  systolic    Int?
  diastolic   Int?
  pulse       Int?
  respRate    Int?     @map("resp_rate")
  spo2        Int?
  weightKg    Float?   @map("weight_kg")
  heightCm    Float?   @map("height_cm")
  bmi         Float?
  recordedBy  String   @map("recorded_by")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vitals")
}

model NurseAssignment {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  nurseId     String   @map("nurse_id")
  assignedBy  String   @map("assigned_by") // Receptionist who assigned
  assignedAt  DateTime @default(now()) @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  rejectedAt  DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason")
  completedAt DateTime? @map("completed_at")
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("nurse_assignments")
  @@index([nurseId, status])
  @@index([encounterId])
}

model DoctorAssignment {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  doctorId    String   @map("doctor_id")
  assignedBy  String   @map("assigned_by") // Nurse who assigned
  assignedAt  DateTime @default(now()) @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  rejectedAt  DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason")
  completedAt DateTime? @map("completed_at")
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("doctor_assignments")
  @@index([doctorId, status])
  @@index([encounterId])
}

model LabTest {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  department     String
  price          Decimal  @db.Decimal(10, 2)
  referenceRange String?  @map("reference_range")
  unit           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  labResults LabResult[]

  @@map("lab_tests")
}

model LabOrder {
  id          String    @id @default(uuid())
  encounterId String    @map("encounter_id")
  patientId   String    @map("patient_id")
  orderedBy   String    @map("ordered_by")
  status      LabStatus @default(ORDERED)
  orderedAt   DateTime  @default(now()) @map("ordered_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id])
  results   LabResult[]
  labAssignments LabAssignment[]

  @@map("lab_orders")
}

model LabResult {
  id        String   @id @default(uuid())
  labOrderId String   @map("lab_order_id")
  labTestId  String   @map("lab_test_id")
  value      String
  unit       String?
  referenceRange String? @map("reference_range")
  flag       String?  // H/L/N (High/Low/Normal)
  enteredBy  String   @map("entered_by")
  enteredAt  DateTime @default(now()) @map("entered_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest  LabTest  @relation(fields: [labTestId], references: [id])

  @@map("lab_results")
}

model LabAssignment {
  id          String   @id @default(uuid())
  labOrderId   String   @map("lab_order_id")
  labTechId   String   @map("lab_tech_id")
  assignedBy  String   @map("assigned_by") // Doctor who assigned
  assignedAt  DateTime @default(now()) @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  rejectedAt  DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason")
  completedAt DateTime? @map("completed_at")
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@map("lab_assignments")
  @@index([labTechId, status])
  @@index([labOrderId])
}

model Service {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  category  String?
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNo      String        @unique @map("invoice_no")
  patientId      String        @map("patient_id")
  encounterId    String?       @map("encounter_id")
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal?      @map("discount_amount") @db.Decimal(12, 2)
  discountReason String?       @map("discount_reason")
  taxAmount      Decimal?      @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  balance        Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime?     @map("issued_at")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  patient   Patient       @relation(fields: [patientId], references: [id])
  encounter Encounter?    @relation(fields: [encounterId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@map("invoices")
  @@index([patientId, status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  itemType    String  @map("item_type") // SERVICE/LAB
  refId       String? @map("ref_id")
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id        String       @id @default(uuid())
  invoiceId String       @map("invoice_id")
  amount    Decimal      @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  receivedBy String      @map("received_by")
  receivedAt DateTime    @default(now()) @map("received_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model FeeConfiguration {
  id          String   @id @default(uuid())
  feeType     FeeType  @map("fee_type")
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([feeType])
  @@map("fee_configurations")
}

model EncounterFee {
  id          String   @id @default(uuid())
  encounterId String   @map("encounter_id")
  feeType     FeeType  @map("fee_type")
  description String
  amount      Decimal  @db.Decimal(12, 2)
  loggedAt    DateTime @default(now()) @map("logged_at")
  loggedBy    String   @map("logged_by")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("encounter_fees")
  @@index([encounterId])
  @@index([feeType])
}

model Attachment {
  id         String   @id @default(uuid())
  encounterId String  @map("encounter_id")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  storagePath String  @map("storage_path")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  actorRole   String   @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  fieldName   String?  @map("field_name")
  before      String?  // JSON
  after       String?  // JSON
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model EmergencyAccess {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  userId      String   @map("user_id")
  reason      String
  authorizedBy String?  @map("authorized_by")
  authorizedAt DateTime? @map("authorized_at")
  expiresAt   DateTime? @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy String?     @map("revoked_by")
  createdAt   DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_access")
  @@index([patientId])
  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id") // Null for system-wide notifications
  patientId   String?  @map("patient_id")
  type        String   // PATIENT_UPDATE, APPOINTMENT_CHANGE, etc.
  title       String
  message     String
  data        String?  // JSON for additional data
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notifications")
  @@index([userId])
  @@index([patientId])
  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // CHECK_IN, COMPLETE_TRIAGE, ASSIGN_DOCTOR, etc.
  entityType String   @map("entity_type") // ENCOUNTER, PATIENT, PRESCRIPTION, etc.
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}