# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=clinic_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Configuration
API_PORT=4000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production Override (for docker-compose.prod.yml)
# NEXT_PUBLIC_API_URL=https://your-domain.com/api
# INTERNAL_API_URL=http://clinic_api_prod:4000

# Deployment Configuration (for CI/CD)
# DEPLOY_PATH=/path/to/clinic-management-on-server
